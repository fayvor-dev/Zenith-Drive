# Google Analytics 4 — Measurement ID (starts with "G-")
# Get this from analytics.google.com > Admin > Data Streams > your web stream
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console — HTML tag verification code only (not the full <meta> tag)
# Get this from search.google.com/search-console > Settings > Ownership verification > HTML tag
# Paste only the "content" value, e.g. from <meta name="google-site-verification" content="abc123" />
# just paste: abc123
NEXT_PUBLIC_GSC_VERIFICATION=
